# The Bank server's secrets. Copy to mcp/.env and fill in; `arcade deploy` reads
# this file and uploads each secret the tools declare to your Arcade project. The values
# never reach the agent or the model.
#
# The server runs in Arcade Cloud, so this address must be reachable from the internet:
# an Aura instance's neo4j+s:// URI, or a tunnel to your local Docker Neo4j (README, setup).
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
