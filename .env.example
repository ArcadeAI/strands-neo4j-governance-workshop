# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- Arcade (module 02) ------------------------------------------------------
# Project API key from the Arcade dashboard (Settings > API keys).
ARCADE_API_KEY=
# ARCADE_BASE_URL=
# Who the agent works for. Empty: each desk's default (pat@ payments, ava@ AML, ian@ banker).
# Staff: pat@, sana@, ava@, marco@, dana@, rita@, omar@, ian@, mia@, cora@bank.example (uv run staff).
BANK_USER=
# The email you sign in to Arcade with. Slack and Gmail run as you, because Arcade's built-in
# OAuth apps bind a grant to the Arcade account that authorized it.
CONNECTED_APPS_USER=

# --- Model (module 01) -------------------------------------------------------
# bedrock, anthropic or scripted. Empty: anthropic if ANTHROPIC_API_KEY is set, otherwise scripted.
MODEL_PROVIDER=
# Optional. Bedrock defaults to Strands' default model; Anthropic to claude-sonnet-5-5.
MODEL_ID=
# Bedrock uses your normal AWS credentials (aws configure / aws sso login / AWS_PROFILE).
AWS_REGION=
# AWS_PROFILE=
ANTHROPIC_API_KEY=

# --- Neo4j (module 02) -------------------------------------------------------
# Aura: neo4j+s://<id>.databases.neo4j.io   Local Docker: bolt://localhost:7687
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=

# --- Control plane (module 02) ----------------------------------------------
# Generate with: openssl rand -hex 32. Paste the same value into Arcade's extension config.
GATE_TOKEN=
GATE_PORT=8742
# Your tunnel's https URL (ngrok http 8742), so `uv run gate` prints the URLs to register.
GATE_PUBLIC_URL=

# --- Telemetry (module 04, optional) ----------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
